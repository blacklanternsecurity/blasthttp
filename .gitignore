/target
/dist

# Vendored OpenSSL source + build artifacts
/vendor/openssl/

# OpenSSL build artifacts that leak into the project root
/apps/
/crypto/
/doc/
/engines/
/exporters/
/fuzz/
/include/
/providers/
/ssl/
/test/
/tools/
/util/
test.py
test_batch.py
test_python_bindings.py
test_urls.txt

# Local agent settings
.claude/

# Python bytecode caches
__pycache__/
*.pyc

# Compiled extension modules. A build left at the repo root shadows the
# installed package, because pytest puts the rootdir on sys.path, so a
# stale one silently gets tested instead of what you just built.
*.so
*.pyd
*.dylib
